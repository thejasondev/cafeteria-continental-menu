# Muestra los precios en el menú (true | false).
# Los dueños no quieren precios públicos: mantener en false.
# Cuando den luz verde: cambiar a "true" y redesplegar (los precios se gestionan en la hoja).
PUBLIC_SHOW_PRICES=false

# URL pública del menú (la que escanea el QR).
# Si Vercel asigna otro dominio o se configura un dominio propio, actualizar aquí y reconstruir.
PUBLIC_MENU_URL=https://cafeteria-continental-menu.vercel.app

# Fuente de precios gestionada por los dueños (Google Sheet -> Apps Script).
# URL del Apps Script con ?token=... ; se usa SOLO en el build y no se expone al navegador.
# Si se deja vacío, los precios se leen de menu.json (comportamiento actual).
PRICES_SOURCE_URL=
