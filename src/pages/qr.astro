---
import BaseLayout from '../layouts/BaseLayout.astro'
import { establecimiento } from '../utils/menu'

const menuUrl = import.meta.env.PUBLIC_MENU_URL || 'https://cafeteria-continental-menu.vercel.app'
---

<BaseLayout
  title="QR del menú — Cafetería Continental"
  description="Código QR para imprimir y escanear el menú digital."
  noindex
  ocultarChrome
>
  <section class="flex min-h-screen flex-col items-center justify-center gap-6 bg-cream p-6">
    <button onclick="window.print()" class="btn-primary no-print">
      Imprimir QR
    </button>

    <article class="print-card w-full max-w-md rounded-3xl border-4 border-dashed border-espresso/25 bg-white p-8 text-center shadow-card">
      <p class="font-display text-2xl font-bold text-espresso">{establecimiento.nombre}</p>
      <p class="mt-1 text-sm text-espresso/60">{establecimiento.direccion}</p>

      <img
        src="/qr-menu.svg"
        alt="Código QR del menú digital de Cafetería Continental"
        width="320"
        height="320"
        class="mx-auto my-6 h-64 w-64"
      />

      <p class="text-lg font-semibold text-caramel">Escanea y descubre nuestra carta</p>
      <p class="mt-1 break-all text-xs text-espresso/50">{menuUrl}</p>

      <p class="mt-4 text-xs text-espresso/50">Desayunos · Bocadillos · Comida casera · Postres</p>
    </article>

    <p class="no-print max-w-md text-center text-xs text-espresso/50">
      Imprime esta página y recorta por la línea de puntos para colocar el QR en las mesas.
      Si cambia la URL del menú, actualiza PUBLIC_MENU_URL y reconstruye el sitio.
    </p>
  </section>
</BaseLayout>
