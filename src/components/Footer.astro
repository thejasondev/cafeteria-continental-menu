---
import { establecimiento, telHref, mapsDirectionsUrl } from '../utils/menu'
---

<footer class="border-t border-espresso/10 bg-cream-dark py-10">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-4 text-center">
    <div class="flex flex-col items-center gap-1">
      <span class="text-2xl" aria-hidden="true">☕</span>
      <p class="font-display text-xl font-bold">{establecimiento.nombre}</p>
      <p class="text-sm text-espresso/60">{establecimiento.direccion}</p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-espresso/70">
      <a href={telHref} class="underline-offset-4 hover:text-caramel hover:underline">{establecimiento.telefono}</a>
      <a href={mapsDirectionsUrl} target="_blank" rel="noopener noreferrer" class="underline-offset-4 hover:text-caramel hover:underline">
        Cómo llegar
      </a>
      <a href="#menu" class="underline-offset-4 hover:text-caramel hover:underline">Volver al menú</a>
    </div>

    <p class="max-w-md rounded-full bg-white/60 px-5 py-2 text-xs text-espresso/60">
      Menú orientativo: pregunta en el local por los precios y los platos del día.
    </p>

    <p class="text-xs text-espresso/40">
      © {new Date().getFullYear()} {establecimiento.nombre} · Menú digital
    </p>
  </div>
</footer>
