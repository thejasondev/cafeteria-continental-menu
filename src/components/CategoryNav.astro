---
import { categorias } from '../utils/menu'
---

<nav
  id="nav-categorias"
  class="no-print sticky top-[61px] z-30 border-y border-espresso/10 bg-cream/95 backdrop-blur"
  aria-label="Categorías del menú"
>
  <ul class="mx-auto flex max-w-5xl items-center gap-2 overflow-x-auto px-4 py-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    {categorias.map((c) => (
      <li>
        <a href={`#cat-${c.id}`} class="chip" data-observa={c.id} aria-current="false">
          <span aria-hidden="true">{c.icono}</span>
          <span>{c.nombre}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLAnchorElement>('#nav-categorias a[data-observa]'))
  const sections = Array.from(document.querySelectorAll<HTMLElement>('section[data-categoria]'))

  if ('IntersectionObserver' in window && sections.length > 0) {
    const activar = (id: string | null) => {
      chips.forEach((chip) => {
        const esActivo = id != null && chip.dataset.observa === id
        chip.setAttribute('aria-current', String(esActivo))
        if (esActivo && !chip.matches(':focus-visible')) {
          chip.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' })
        }
      })
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visibles = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)
        if (visibles.length > 0) {
          const id = visibles[0].target.getAttribute('data-categoria')
          activar(id)
        }
      },
      { rootMargin: '-35% 0px -60% 0px', threshold: [0.05, 0.2, 0.4, 0.6] }
    )

    sections.forEach((section) => observer.observe(section))
  }
</script>
