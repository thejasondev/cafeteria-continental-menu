---
import { establecimiento, telHref, mapsDirectionsUrl, mapsOpenUrl, mapsEmbedUrl } from '../utils/menu'
---

<section id="ubicacion" class="anchor-offset scroll-mt-40 border-t border-espresso/10 bg-espresso py-16 text-cream sm:py-20">
  <div class="mx-auto max-w-5xl px-4">
    <div class="mb-10 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-gold">Dónde estamos</p>
      <h2 class="mt-2 font-display text-3xl font-bold sm:text-4xl">Visítanos en El Matorral</h2>
    </div>

    <div class="grid items-stretch gap-6 md:grid-cols-2">
      <div class="flex flex-col gap-6 rounded-3xl bg-espresso-soft/60 p-7">
        <div class="flex items-start gap-4">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold/20 text-gold" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
          <div>
            <h3 class="font-display text-lg font-semibold">Dirección</h3>
            <p class="mt-1 text-sm text-cream/75">{establecimiento.direccion}</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold/20 text-gold" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </span>
          <div>
            <h3 class="font-display text-lg font-semibold">Horario</h3>
            <ul class="mt-1 space-y-1 text-sm text-cream/75">
              {establecimiento.horario.map((linea) => (
                <li>{linea}</li>
              ))}
            </ul>
            {establecimiento.notaHorario && (
              <p class="mt-1 text-xs italic text-cream/50">{establecimiento.notaHorario}</p>
            )}
          </div>
        </div>

        <div class="flex items-start gap-4">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold/20 text-gold" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </span>
          <div>
            <h3 class="font-display text-lg font-semibold">Teléfono</h3>
            <a href={telHref} class="mt-1 inline-block text-sm text-cream/75 underline-offset-4 hover:text-gold hover:underline">
              {establecimiento.telefono}
            </a>
          </div>
        </div>

        <div class="mt-2 flex flex-wrap gap-3 border-t border-cream/10 pt-6">
          <a href={mapsDirectionsUrl} target="_blank" rel="noopener noreferrer" class="btn-primary no-print">
            Cómo llegar
          </a>
          <a href={mapsOpenUrl} target="_blank" rel="noopener noreferrer" class="btn-outline no-print">
            Abrir en Google Maps
          </a>
        </div>
      </div>

      <div class="overflow-hidden rounded-3xl border border-cream/10 shadow-card">
        <iframe
          src={mapsEmbedUrl}
          title={`Mapa de ${establecimiento.nombre}`}
          aria-label={`Mapa de ${establecimiento.nombre} — ${establecimiento.direccion}`}
          class="h-full min-h-[320px] w-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
          tabindex="0"
        ></iframe>
      </div>
    </div>
  </div>
</section>
