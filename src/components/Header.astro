---
import { establecimiento, telHref } from '../utils/menu'
---

<header class="sticky top-0 z-40 border-b border-espresso/10 bg-cream/90 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3">
    <a href="#inicio" class="flex items-center gap-2.5" aria-label="Ir al inicio">
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-espresso text-lg" aria-hidden="true">☕</span>
      <span class="flex flex-col leading-tight">
        <span class="font-display text-lg font-bold">{establecimiento.nombre}</span>
        <span class="hidden text-xs text-espresso/60 sm:block">El Matorral · Fuerteventura</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Navegación principal">
      <a href="#menu" class="rounded-full px-4 py-2 text-sm font-medium text-espresso/80 transition-colors hover:bg-espresso/5 hover:text-caramel">Menú</a>
      <a href="#ubicacion" class="rounded-full px-4 py-2 text-sm font-medium text-espresso/80 transition-colors hover:bg-espresso/5 hover:text-caramel">Cómo llegar</a>
    </nav>

    <a href={telHref} class="inline-flex items-center gap-2 rounded-full bg-caramel px-4 py-2 text-sm font-semibold text-cream shadow-card transition-colors hover:bg-espresso">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <span class="hidden sm:inline">Llamar</span>
    </a>
  </div>
</header>
