---
import { alergenosList } from '../utils/menu'
---

<aside class="rounded-2xl border border-gold/30 bg-white p-5 shadow-card sm:p-6" aria-labelledby="titulo-alergenos">
  <div class="flex items-center gap-2">
    <span class="text-lg" aria-hidden="true">⚠️</span>
    <h2 id="titulo-alergenos" class="font-display text-lg font-semibold">Información de alérgenos</h2>
  </div>

  <ul class="mt-3 flex flex-wrap gap-2">
    {alergenosList.map((a) => (
      <li class="flex items-center gap-1.5 rounded-full bg-cream px-3 py-1.5 text-sm text-espresso/80">
        <span aria-hidden="true">{a.emoji}</span>
        <span>{a.nombre}</span>
      </li>
    ))}
  </ul>
</aside>
